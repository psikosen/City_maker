[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.35
anti_aliasing/screen_space_roughness_limiter/limit=0.14
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true
environment/screen_space_reflection/half_size=true
limits/global_shader_variables/buffer_size=262144

[shader_globals]

